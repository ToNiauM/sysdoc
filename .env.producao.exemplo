# Exemplo de configuração de PRODUÇÃO. Copie para `.env` no servidor e
# ajuste. Este arquivo é versionado como referência e não contém segredo.
#
#   cp .env.producao.exemplo .env && ${EDITOR:-nano} .env
#
# Usado junto com:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# ---------------------------------------------------------------------------
# Identidade pública
# ---------------------------------------------------------------------------
# Hostname pelo qual os pregoeiros acessam. Precisa bater exatamente com o
# `server_name` do proxy reverso e com o registro DNS no Cloudflare.
SYSDOC_WEB_ALLOWED_HOSTS=sysdoc.sistemascfc.org

# Origem confiável para verificação de CSRF. Precisa incluir o esquema.
SYSDOC_WEB_CSRF_ORIGINS=https://sysdoc.sistemascfc.org

# ---------------------------------------------------------------------------
# Segredo
# ---------------------------------------------------------------------------
# Gere no servidor com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Trocar esta chave depois invalida todas as sessões ativas (os pregoeiros
# precisam entrar de novo) — não é destrutivo, mas evite trocar à toa.
DJANGO_SECRET_KEY=

# ---------------------------------------------------------------------------
# Rede interna
# ---------------------------------------------------------------------------
# Porta no host onde o container escuta, publicada SOMENTE em 127.0.0.1.
# Escolha uma porta livre — confira com `ss -ltn | grep <porta>` antes.
# É esta porta que o `proxy_pass` do nginx precisa apontar.
SYSDOC_WEB_PORTA_LOCAL=8010

# ---------------------------------------------------------------------------
# Configuração do motor de análise (chaves de API)
# ---------------------------------------------------------------------------
# Diretório do servidor com o `config.json` usado por `sysdoc-dvi config`
# (chaves de provedor + escolha de modelos). Montado somente-leitura no
# container. Caminho ABSOLUTO — não use `~`.
#
# ATENÇÃO à permissão: o processo no container roda com UID 10001 e precisa
# conseguir ler. Com o padrão `700`/`600` a montagem fica ilegível. Ajuste:
#   chmod o+rx /opt/sysdoc-config && chmod o+r /opt/sysdoc-config/config.json
# Alternativa mais restrita, sem abrir para "outros":
#   chown -R 10001:10001 /opt/sysdoc-config
SYSDOC_CONFIG_DIR=/opt/sysdoc-config

# ---------------------------------------------------------------------------
# Limites de upload
# ---------------------------------------------------------------------------
SYSDOC_WEB_MAX_UPLOAD_MB=50

# ---------------------------------------------------------------------------
# Alternativa às chaves em SYSDOC_CONFIG_DIR
# ---------------------------------------------------------------------------
# Preencher aqui é o caminho secundário; o preferido é o `config.json` acima.
# Nunca são exibidas ao pregoeiro nem trafegam para o navegador (D-05).
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
